{
  "mcpdesc": "0.7.0",
  "info": {
    "name": "resources-server",
    "description": "Test server with resources support",
    "version": "1.0.0",
    "protocolVersion": "2025-06-18"
  },
  "transports": [
    {
      "type": "stdio",
      "command": "node",
      "args": ["resources-server.js"]
    }
  ],
  "capabilities": {
    "resources": {
      "subscribe": false,
      "listChanged": false
    }
  },
  "resources": [
    {
      "uri": "config://app",
      "name": "Application Configuration",
      "description": "Application configuration settings",
      "mimeType": "application/json"
    },
    {
      "uri": "docs://readme",
      "name": "README Documentation",
      "description": "Project README file",
      "mimeType": "text/plain"
    },
    {
      "uri": "schema://user",
      "name": "User Schema",
      "description": "JSON Schema for user objects",
      "mimeType": "application/schema+json"
    }
  ],
  "resourceTemplates": [
    {
      "uriTemplate": "file:///{path}",
      "name": "File Resource",
      "description": "Access files by path",
      "mimeType": "text/plain"
    },
    {
      "uriTemplate": "data:///{id}",
      "name": "Data Resource",
      "description": "Access data objects by ID",
      "mimeType": "application/json"
    }
  ]
}
